<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 30 and below (full-backup-content).

   The offline write queue (unsent records plus their staged attachment images) is excluded: it is
   device-local, in-flight state, and restoring it onto another device could replay writes against
   whatever server is configured there. Settings (including the API key / password, which are
   encrypted with a non-exportable Android Keystore key and fail closed on another device) are left
   in backup so a restore keeps the user's preferences.
-->
<full-backup-content>
    <exclude domain="file" path="queue" />
</full-backup-content>
